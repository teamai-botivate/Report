# ---- Database ----
# Local dev default: SQLite file (no Docker/Postgres required to run).
DATABASE_URL=sqlite+aiosqlite:///./bi_platform.db
# Production: paste a Neon Postgres URL as-is (Neon console format is fine, e.g.
# postgresql://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require&channel_binding=require)
# DATABASE_URL=postgresql://user:pass@ep-xxxx.neon.tech/dbname?sslmode=require&channel_binding=require
# Optional: separate read-only Postgres role DSN for AI-generated analytical queries in prod.
# DATABASE_URL_READONLY=postgresql://readonly_user:pass@ep-xxxx.neon.tech/dbname?sslmode=require

# ---- OpenAI (text) ----
# Leave blank to run with AI disabled (heuristic reports still work with zero LLM calls).
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1

# ---- OpenAI (image, decorative-only) ----
# Used ONLY for empty-state illustrations / report banners — never for charts, KPIs, or tables.
OPENAI_IMAGE_MODEL=gpt-image-2

# ---- Seeding ----
SEED_SIZE=medium
AUTO_SEED_ON_BOOT=true

# ---- SQL safety ----
SQL_QUERY_TIMEOUT_MS=8000
SQL_MAX_ROWS=5000
SQL_MAX_RETRY=2

# ---- Misc ----
ENV=dev
DEBUG=true
CORS_ORIGINS=http://localhost:3000
# Set by Docker deployment only — internal URL of the Next.js standalone server.
# FRONTEND_PROXY_URL=http://127.0.0.1:3000
